{
  "name": "@mafia/server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "migrate": "tsx src/migrate.ts",
    "build": "tsup src/main.ts src/migrate.ts src/initialize-storage.ts src/migrate-postgres-to-storage.ts --format esm --out-dir dist --clean && cp src/schema.sql dist/schema.sql",
    "test": "vitest run --no-file-parallelism",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/identity": "4.13.3",
    "@azure/storage-blob": "12.34.0",
    "@fastify/helmet": "^13.1.1",
    "@fastify/static": "^10.1.3",
    "@mafia/game-domain": "^1.0.0",
    "fastify": "^5.12.0",
    "pg": "^8.23.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "vitest": "^4.1.10"
  }
}
