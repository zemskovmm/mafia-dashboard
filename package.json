{
  "name": "mafia-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Touch-first dashboard for moderating in-person Sport Mafia games",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "npm run migrate -w @mafia/server && concurrently --kill-others-on-fail --names server,web \"npm run dev -w @mafia/server\" \"npm run dev -w @mafia/web\"",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "verify:oauth": "node scripts/verify-oauth.mjs",
    "verify:compose": "node scripts/verify-production-compose.mjs",
    "verify:session": "node scripts/verify-session-state.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
