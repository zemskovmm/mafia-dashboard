{
  "name": "mafia-dashboard",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Touch-first dashboard for moderating in-person Sport Mafia games",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22",
    "npm": ">=10"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs",
    "dev:localhost": "node scripts/dev-local.mjs --local",
    "dev:web": "npm run dev -w @mafia/web -- --host 127.0.0.1 --strictPort",
    "ci:install": "npm ci --ignore-scripts --no-audit && npm rebuild esbuild",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test:local-contracts && npm run test:security-contracts && npm run test:azure-contracts && npm run test:verifier-contracts && npm run test:backup-contracts && npm run test:storage-backup && npm run test:production-migration && npm run test:release-contracts && npm run test --workspaces --if-present",
    "test:local-contracts": "node --test scripts/local-stack.test.mjs scripts/local-backend.test.mjs scripts/test-local.test.mjs scripts/local-azurite.test.mjs",
    "test:local": "node scripts/test-local.mjs",
    "check:local": "node scripts/test-local.mjs --check",
    "verify:local": "node scripts/verify-local-backend.mjs",
    "test:backup-contracts": "node --test scripts/postgres-backup-contracts.test.mjs",
    "test:storage-backup": "node --import tsx --test scripts/storage-backup.test.mjs scripts/storage-backup-runtime.test.mjs",
    "storage:backup": "node --import tsx scripts/storage-backup.mjs",
    "storage:restore": "node --import tsx scripts/storage-restore.mjs",
    "verify:storage-backup": "node --import tsx scripts/verify-storage-backup.mjs",
    "storage:migrate-postgres": "node --import tsx apps/server/src/migrate-postgres-to-storage.ts",
    "test:production-migration": "node --import tsx --test scripts/production-postgres-migration.test.mjs scripts/production-postgres-migration-runtime.test.mjs",
    "test:release-contracts": "node --test scripts/release-verifier-contracts.test.mjs",
    "test:security-contracts": "node --test scripts/security-workflow-contracts.test.mjs",
    "test:azure-contracts": "node --test scripts/azure-deployment-plan.test.mjs scripts/azure-deployment-cli.test.mjs scripts/azure-template-contracts.test.mjs",
    "test:verifier-contracts": "node --test scripts/session-verifier-contracts.test.mjs",
    "verify:oauth": "node scripts/verify-oauth.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "verify:compose": "node scripts/verify-production-compose.mjs",
    "verify:backup": "node scripts/verify-postgres-backup.mjs",
    "verify:session": "node scripts/verify-session-state.mjs",
    "verify:ui": "node scripts/verify-ui.mjs",
    "verify:night-check-glow": "node scripts/verify-night-check-glow.mjs",
    "verify:ui-hardening": "node scripts/verify-ui-hardening.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "azurite": "3.37.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-no-unsanitized": "^4.1.5",
    "eslint-plugin-security": "^4.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0"
  }
}
