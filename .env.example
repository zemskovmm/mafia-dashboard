# Optional credentials for the owned local Azure development workflow.
# Copy to .env.local, restrict it to the current user (chmod 600 .env.local),
# and fill only the settings needed. Never commit the populated file.
# npm run dev supplies the canonical origin and its owned Azurite namespace.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Register the exact /api/music/oauth/callback URL for the chosen browser origin.
GOOGLE_OAUTH_REDIRECT_URI=
# Generate once with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MUSIC_TOKEN_ENCRYPTION_KEY=
