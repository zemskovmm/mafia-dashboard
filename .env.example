VITE_YOUTUBE_PLAYLIST_ID=
APP_BIND=127.0.0.1
APP_PORT=8080
# Canonical HTTPS origin; Google sign-in callback is derived as /api/auth/google/callback.
PUBLIC_APP_URL=https://your-tailnet-host.ts.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate OAuth callback used for read-only YouTube Music library access.
GOOGLE_OAUTH_REDIRECT_URI=https://your-tailnet-host.ts.net/api/music/oauth/callback
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MUSIC_TOKEN_ENCRYPTION_KEY=
DATABASE_URL=postgresql://mafia:change-me@db:5432/mafia
POSTGRES_USER=mafia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mafia
