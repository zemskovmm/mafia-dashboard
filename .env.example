VITE_YOUTUBE_PLAYLIST_ID=
APP_IMAGE=mafia-dashboard:local
APP_BIND=127.0.0.1
APP_PORT=8080
# Keep 0 for direct access; use 1 only behind the documented single reverse proxy.
TRUST_PROXY_HOPS=0
# Canonical HTTPS origin; Google sign-in callback is derived as /api/auth/google/callback.
PUBLIC_APP_URL=https://your-tailnet-host.ts.net
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Separate OAuth callback used for read-only YouTube Music library access.
GOOGLE_OAUTH_REDIRECT_URI=https://your-tailnet-host.ts.net/api/music/oauth/callback
# Generate with: openssl rand -base64 32 | tr '+/' '-_' | tr -d '='
MUSIC_TOKEN_ENCRYPTION_KEY=
# Override with a complete TLS-enabled URL when using compose.external-db.yaml.
DATABASE_URL=postgresql://mafia:change-me@db:5432/mafia
POSTGRES_USER=mafia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=mafia
# Existing host directories. BACKUP_OFFSITE_DIR must be a separately managed off-server mount.
BACKUP_LOCAL_DIR=
BACKUP_OFFSITE_DIR=
BACKUP_RETENTION_DAYS=14
BACKUP_OFFSITE_RETENTION_DAYS=30
